<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- All Anomaly-related letters -->
    <BetterLetters.LetterIconOverrideDef MayRequire="Ludeon.RimWorld.Anomaly">
        <defName>Anomaly</defName>
        <iconPath>UI/Letters/LetterAnomaly</iconPath>
        <gameConditions>
            <li>DeathPall</li>
            <li>GrayPall</li>
            <li>BloodRain</li>
            <li>HateChantDrone</li>
            <li>UnnaturalDarkness</li>
            <li>UnnaturalHeat</li>
        </gameConditions>
        <incidents>
            <li>HarbingerTreeSpawn</li>
            <li>FrenziedAnimals</li>
            <li>PitGate</li>
            <li>ShamblerSwarm</li>
            <li>PsychicRitualSiege</li>
            <li>VoidCuriosity</li>
        </incidents>
        <things>
            <li>VoidMonolith</li>
        </things>
        <patchTargets>
            <li>
                <typeName>CompDreadmeld</typeName>
                <methodName>Notify_Killed</methodName>
            </li>
            <li>
                <typeName>CompHoldingPlatformTarget</typeName>
                <methodName>Escape</methodName>
            </li>
            <li>
                <typeName>Building_VoidMonolith</typeName>
                <methodName>Tick</methodName>
            </li>
            <li>
                <typeName>GameComponent_Anomaly</typeName>
                <methodName>GameComponentTick</methodName>
            </li>
            <li>
                <typeName>CompStudyUnlocks</typeName>
                <methodName>RegisterStudyLevel</methodName>
            </li>
            <!-- More anomaly letters go here -->
        </patchTargets>
    </BetterLetters.LetterIconOverrideDef>

</Defs>
