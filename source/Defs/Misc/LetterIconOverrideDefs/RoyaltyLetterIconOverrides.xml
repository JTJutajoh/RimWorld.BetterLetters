<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- All Royalty-related letters -->
    <BetterLetters.LetterIconOverrideDef MayRequire="Ludeon.RimWorld.Royalty">
        <defName>Royalty</defName>
        <iconPath>UI/Letters/LetterRoyalty</iconPath>
        <incidents>
            <li>CaravanArrivalTributeCollector</li>
            <li>AnimaTreeSpawn</li>
        </incidents>
        <iconResolverClass>BetterLetters.LetterIconOverrideResolvers.RoyaltyIconOverrideResolver</iconResolverClass>
        <patchTargets>
            <li>
                <typeName>Pawn_RoyaltyTracker</typeName>
                <methodName>OnPreTitleChanged</methodName>
            </li>
            <li>
                <typeName>RitualOutcomeEffectWorker_Bestowing</typeName>
                <methodName>Apply</methodName>
            </li>
        </patchTargets>
    </BetterLetters.LetterIconOverrideDef>

</Defs>
