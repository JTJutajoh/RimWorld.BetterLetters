<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- All Royalty-related letters -->
    <BetterLetters.LetterIconOverrideDef MayRequire="Ludeon.RimWorld.Royalty">
        <defName>Royalty</defName>
        <iconPath>UI/Letters/LetterRoyalty</iconPath>
        <incidents>
            <li>CaravanArrivalTributeCollector</li>
            <li>AnimaTreeSpawn</li>
        </incidents>
        <resolverClass>BetterLetters.LetterIconOverrideResolvers.RoyaltyIconOverrideResolver</resolverClass>
        <patchWorker Class="BetterLetters.GenericTranspilerPatchWorker" />
    </BetterLetters.LetterIconOverrideDef>



    <BetterLetters.LetterIconOverrideDef MayRequire="Ludeon.RimWorld.Royalty">
        <defName>Concert</defName>
        <iconPath>UI/Letters/LetterConcert</iconPath>
        <gatherings>
            <li>Concert</li>
        </gatherings>
    </BetterLetters.LetterIconOverrideDef>

</Defs>
